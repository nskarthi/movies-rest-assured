<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MovieDB API Suite" parallel="methods" thread-count="3">
	<listeners>
		<listener class-name="com.moviedb.listeners.AnnotationTransformer" />
		<listener class-name="com.moviedb.listeners.ExtentReportManager" />
	</listeners>

	<test name="Movie related tests">
		<packages>
			<package name="com.moviedb.tests.movies" />
		</packages>
	</test>
	<test name="System related tests">
		<packages>
			<package name="com.moviedb.tests.system" />
		</packages>
	</test>
</suite>
